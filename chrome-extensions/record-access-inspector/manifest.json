{
  "manifest_version": 3,
  "name": "Salesforce Record Access Inspector",
  "version": "1.0.0",
  "description": "Explain whether a user can access a Salesforce record, and how the record is shared — using your current login session.",
  "action": {
    "default_title": "Record Access Inspector",
    "default_popup": "popup.html"
  },
  "permissions": ["cookies", "storage", "activeTab"],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.cloudforce.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
